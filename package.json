{
  "name": "projectpages",
  "version": "1.25.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/wridgeu/github_pages.git"
  },
  "homepage": "https://wridgeu.github.io/",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "ui5 build self-contained --all --include-task=generateVersionInfo --clean-dest",
    "start": "ui5 serve --port 8080 -o index.html",
    "serve": "ui5 serve --port 8080",
    "start:dist": "ui5 serve  --port 8080 -o index.html --config ui5-dist.yaml",
    "start:build": "ui5 serve -o index.html --config ui5-dist.yaml",
    "ts-typecheck": "tsc --noEmit",
    "lint": "oxlint webapp",
    "ui5lint": "ui5lint",
    "test": "playwright test",
    "build:deploy": "ui5 build self-contained --all --include-task=generateVersionInfo --clean-dest --dest ./dist"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "highlight.js": "^11.9.0",
    "marked": "^18.0.6",
    "marked-highlight": "^2.2.4"
  },
  "devDependencies": {
    "@openui5/types": "~1.150.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@ui5/cli": "^4.0.57",
    "@ui5/linter": "^1.23.1",
    "oxlint": "^1.74.0",
    "typescript": "~6.0.3",
    "ui5-middleware-livereload": "^3.3.1",
    "ui5-task-minifier": "^2.0.1",
    "ui5-tooling-modules": "^3.37.8",
    "ui5-tooling-transpile": "^3.12.0"
  }
}

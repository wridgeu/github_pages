{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"preserveConstEnums": true,
		"sourceMap": false,
		"allowJs": true,
		"strict": true,
		"strictNullChecks": false,
		"importHelpers": true,
		"forceConsistentCasingInFileNames": true,
		"strictPropertyInitialization": false,
		"rootDir": "./webapp",
		"outDir": "./dist",
		"types": ["@openui5/types"],
		"paths": {
			"sapmarco/projectpages/*": ["./webapp/*"]
		}
	},
	"include": ["./webapp/**/*"]
}
